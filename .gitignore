# Legacy/defensive only — setup-skills.sh now clones to $HOME, not here (a clone in the
# workshop's own folder gets shadowed by `docker run`'s bind mount over that same folder,
# leaving every skill symlink dangling). Kept in case an old checkout or cached image still
# writes one of these.
tollbooth/Anthropic-Cybersecurity-Skills/
tailgate/Anthropic-Cybersecurity-Skills/
fastlane/Anthropic-Cybersecurity-Skills/
dashcam/Anthropic-Cybersecurity-Skills/

# Scratch evidence bundles generated while working an exercise (doesn't touch committed
# evidence living in subfolders like network/, ad/, guestlist/, app/, speedbump/).
# TollBooth's own Section 2 output lives in tollbooth/evidence/ (see its README); the
# other exercises still drop theirs at their own top level.
tollbooth/evidence/*
!tollbooth/evidence/README.md
tailgate/*.txt
fastlane/*.txt
!tailgate/SETUP.md
!fastlane/SETUP.md
.env*
!.env.example
.DS_Store

# Dashcam's local Python venv (Option B, no Docker)
dashcam/.venv/

# Casky Box's evidence bind mount — files workshops drop in at Section 2 time,
# not committed content (same reasoning as the *.txt rule above).
casky-box/evidence/*
!casky-box/evidence/README.md

# Claude Code's own local, per-session permission state (auto-generated by
# running `claude` interactively inside tollbooth/) — machine/session-local,
# not shared workshop content.
**/.claude/settings.local.json
