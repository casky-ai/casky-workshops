# Copy to .env in this folder — same key as every workshop's own .env (the
# "shared key" each SETUP.md refers to). Quotes are fine here: Compose's own
# .env parser strips them correctly (unlike `docker run --env-file`, which is
# why each workshop's own .env needs the quotes stripped separately).
ANTHROPIC_API_KEY=sk-ant-...

# Optional — leave blank to run Casky Box in local mode (findings stored in
# /var/casky/reports/ inside the runner container, browsable via casky-ui).
CASKY_API_KEY=
GOOGLE_API_KEY=

# Optional — defaults to "casky" if left blank.
DB_PASSWORD=casky
