# ── Required (unless using a BYO-LLM provider below) ────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Optional: BYO-LLM for the classifier pipeline ────────────────────────────
# Casky's investigation-plan classifier (casky_pipeline) is model-agnostic.
# Defaults to Anthropic direct using ANTHROPIC_API_KEY above. To use OpenAI,
# Qwen, Kimi, or a local model (Ollama / LM Studio / vLLM) instead, set:
CASKY_MODEL_PROVIDER=anthropic
# CASKY_MODEL_PROVIDER=openai_compatible
# CASKY_MODEL_BASE_URL=https://api.openai.com/v1       # or http://localhost:11434/v1 (Ollama)
# CASKY_MODEL_NAME=gpt-4o-mini                          # provider-specific model id
# CASKY_MODEL_API_KEY=                                  # bearer token, if the endpoint needs one
#
# Sampling temperature for every classifier pipeline stage (technique
# validation, skill selection, step ordering, evidence-gap analysis, memory
# extraction). Defaults to 0.0 (not the API's own default of 1.0) — these are
# all classification/extraction tasks, so determinism is the right default:
# running the same evidence twice should produce the same plan, not a
# different set of MITRE techniques/skills each time. Raise it if you
# actually want more exploratory variance across runs.
CASKY_MODEL_TEMPERATURE=0.0
#
# Note: this is separate from the coding-agent CLI selection (--agent claude|gemini|
# copilot|custom in 'casky run') — this controls which LLM *generates the investigation
# plan itself*, not which agent executes each step.

# ── Optional: Postgres persistence layer (casky_db) ──────────────────────────
# When set, 'casky harness' persists investigation plans/steps/findings/reports
# to Postgres (casky_db/) instead of ~/.casky/plans/*.json + /var/casky/reports/.
# Defaults to the bundled `db` service in docker-compose.yml. Leave unset to
# keep the pre-Postgres JSON-file storage (a real, expected transitional
# state — nothing breaks without it). Override to point at an external
# Postgres instead of the bundled one.
DATABASE_URL=postgresql://casky:casky@db:5432/casky

# ── Optional: Casky platform sync ────────────────────────────────────────────
# CASKY_API_KEY: generate at casky.ai/profile → Runner Token.
# When set, 'casky harness' fetches investigation plans from your dashboard and
# reports findings back. Leave empty for local mode (findings → /var/casky/reports/).
CASKY_API_KEY=
CASKY_APP_URL=https://casky.ai
CASKY_LOCAL_PORT=8765

# Legacy single-run vars — still work for manual: casky run <skill>
CASKY_RUN_ID=
CASKY_TOKEN=

# Max concurrent agent(s) 'casky harness --auto' runs at once.
CASKY_CONCURRENCY=4

# ── Optional: Gemini CLI ──────────────────────────────────────────────────────
# Either name works — casky.sh accepts GOOGLE_API_KEY or GEMINI_API_KEY.
GOOGLE_API_KEY=
# GEMINI_API_KEY=

# ── Optional: CVE MCP API keys ───────────────────────────────────────────────
# Without these, only NVD + EPSS + CISA KEV are queried (free, no key needed).
# cve-mcp-server docs: https://github.com/mukul975/cve-mcp-server
NVD_API_KEY=
GITHUB_TOKEN=
SHODAN_KEY=
VIRUSTOTAL_KEY=
GREYNOISE_API_KEY=
ABUSEIPDB_KEY=
URLSCAN_KEY=
CIRCL_PDNS_USER=
CIRCL_PDNS_PASS=

# ── Optional: Skills library ──────────────────────────────────────────────────
# Path where skills library is mounted (default: /opt/skills-library).
# After 'docker compose up casky-skills', the 754-skill mukul975 library
# is available at this path for plan generation and execution.
SKILLS_LIBRARY_PATH=/opt/skills-library

# ── Optional: Lab profile & target selection ────────────────────────────────
# Choose ONE target profile:
#   docker compose --profile lab-dvwa up -d       # DVWA (requires MariaDB, bundled)
#   docker compose --profile lab-juice-shop up -d # OWASP Juice Shop (self-contained)
#   docker compose --profile lab-custom up -d     # Custom target (set TARGET_IMAGE below)
#
# Defaults: lab-dvwa profile, web-app skill
SKILL_IMAGE=ghcr.io/casky-ai/skills/web-app:latest
SKILL_LAB_NAME=skill-lab

# For lab-custom profile, specify your target container image
TARGET_IMAGE=ghcr.io/casky-ai/targets/dvwa:latest

# ── Optional: Live-target mode (real, authorized targets only) ─────────────
# `make live LIVE_TARGET=<host-or-url> AUTHORIZED=yes SKILL=web-app` — see README's
# "Live, authorized real-target investigations" section and SECURITY.md before using
# this. By default produces a runbook (uses skill-lab, no execution against the
# target). Add NETWORK_ACCESS=yes for direct execution instead — that's what uses
# skill-live (real internet egress), named below.
SKILL_LIVE_NAME=skill-live

# ── Optional: Casky UI (self-hosted, browses the casky_db Postgres schema) ───
# See README's "Casky UI" section. Requires DATABASE_URL above (no JSON-file
# fallback, unlike the CLI harness).
#
# Leave unset to auto-generate a password on first boot — printed once to
# `docker compose logs ui` and persisted (hashed) so it survives a restart.
# Set it to choose your own password, or to rotate the existing one (change
# + restart the `ui` container).
CASKY_UI_ADMIN_PASSWORD=
# Host port Casky UI is reachable on.
CASKY_UI_PORT=8766
# Bind address for CASKY_UI_PORT — 0.0.0.0 to expose beyond localhost. There's
# no RBAC, only the single admin login above, so think about your network
# before doing that on anything but a trusted host.
CASKY_UI_HOST=127.0.0.1
# The bundled docker-compose stack serves Casky UI over plain HTTP — no TLS
# termination anywhere in this repo. Only set this to "true" if you've put
# your own TLS-terminating reverse proxy in front of it; leave unset
# otherwise. Setting it without actually being behind HTTPS makes the browser
# silently drop the session cookie on arrival — every route bounces straight
# back to /login, as if login never happened at all.
# CASKY_UI_FORCE_SECURE_COOKIE=true

# ── Database passwords ───────────────────────────────────────────────────────
# Used only with lab-dvwa profile (DVWA + MariaDB — DVWA's setup.php uses
# MariaDB-specific DDL syntax (ADD COLUMN IF NOT EXISTS), which Oracle MySQL
# has never supported at any version; see docker-compose.yml's target-db
# comment for how this was confirmed)
DB_ROOT_PASSWORD=root
DB_PASSWORD=dvwa
